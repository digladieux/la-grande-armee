---
import PageShell from '@/layouts/PageShell.astro';
import CharacterCard from '@/components/characters/CharacterCard.astro';
import CharacterDialogs from '@/components/characters/CharacterDialogs.astro';
import { characters } from '@/data/characters';
import { pickCovers } from '@/lib/covers';

const covers = pickCovers(characters);
---

<PageShell title="Personnages" eyebrow="La bande" intro="Tous les membres de La Grande Armée, famille par famille." accent="green">
  <ul class="grid">
    {characters.map((c) => (
      <li id={c.slug}>
        <CharacterCard character={c} lookIndex={covers.get(c.slug)} />
      </li>
    ))}
  </ul>
  <CharacterDialogs characters={characters} />
</PageShell>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Téléphone : grille de 2 cartes par ligne, cartes plus compactes */
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .grid :global(.card__body) {
      padding: 8px 8px 10px;
    }
    .grid :global(.card__name) {
      font-size: 1.1rem;
    }
    .grid :global(.card__families) {
      margin-top: 5px;
      gap: 4px;
    }
    .grid :global(.card__dot) {
      width: 10px;
      height: 10px;
    }
    .grid :global(.card__tagline) {
      margin-top: 4px;
      font-size: 0.72rem;
      line-height: 1.3;
    }
    .grid :global(.card__count) {
      top: 6px;
      right: 6px;
      padding: 0 7px;
      font-size: 0.85rem;
    }
  }
</style>
