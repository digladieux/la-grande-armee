---
import PageShell from '@/layouts/PageShell.astro';
import CharacterCard from '@/components/characters/CharacterCard.astro';
import { characters } from '@/data/characters';
---

<PageShell title="Personnages" eyebrow="La bande" intro="Tous les membres de La Grande Armée, famille par famille." accent="green">
  <ul class="grid">
    {characters.map((c) => (
      <li id={c.slug}>
        <CharacterCard character={c} showTagline />
      </li>
    ))}
  </ul>
</PageShell>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
