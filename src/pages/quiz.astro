---
// Ancienne adresse du quiz : redirige vers /jeux/quiz
import { url } from '@/lib/url';
const target = url('/jeux/quiz');
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Quiz</title>
  </head>
  <body>
    <a href={target}>Le quiz a déménagé dans l'onglet Jeux</a>
  </body>
</html>
