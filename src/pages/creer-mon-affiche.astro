---
import PageShell from '@/layouts/PageShell.astro';
import PosterConfigurator from '@/features/poster-configurator/PosterConfigurator';
import ModelesAffiches, { type Modele } from '@/features/poster-configurator/ModelesAffiches';
import recettes from '../../sources/affiches/familles/recettes.json';
import recettesCopains from '../../sources/affiches/copains/recettes.json';
import type { RosterEntry } from '@/features/poster-configurator/types';
import { characters } from '@/data/characters';
import { families } from '@/data/families';
import { cropTransform } from '@/lib/crop';
import { url } from '@/lib/url';
import { pngSize } from '@/lib/png-size';

/** Hauteur des illustrations d'origine (cartes du jeu). */
const CARD_HEIGHT = 1068;

// Les copains dessinés d'abord, puis les cases « ? » (personnages provisoires).
const roster: RosterEntry[] = [...characters]
  .sort((a, b) => Number(!!b.looks?.length) - Number(!!a.looks?.length))
  .map((c) => ({
    slug: c.slug,
    name: c.name,
    looks: (c.looks ?? []).map((l) => ({
      familyName: families[l.family].name,
      familyColor: families[l.family].color,
      familyBg: families[l.family].bg,
      image: url(`/${l.image}`),
      bust: cropTransform(l.bust),
      animation: l.animation,
      cutout: l.cutout ? url(`/${l.cutout}`) : undefined,
      // Hauteur du personnage détouré rapportée à la carte : garde l'échelle du dessin sur l'affiche
      // (rapportée à l'illustration elle-même : certaines tenues sont en HD, cadre ×2)
      cutoutScale: l.cutout ? (pngSize(l.cutout)?.height ?? CARD_HEIGHT) / (pngSize(l.image)?.height ?? CARD_HEIGHT) : undefined,
      // Largeur / hauteur du détourage (pour la disposition automatique de l'affiche)
      cutoutRatio: l.cutout ? ((s) => (s ? s.width / s.height : 0.6))(pngSize(l.cutout)) : undefined,
      whiteBg: l.whiteBg,
    })),
  }));

// Affiches toutes faites, une par famille (sources/affiches/familles.py) : Izi Karaté en premier
const ordre = ['izi-karate', ...Object.keys(recettes).filter((f) => f !== 'izi-karate')];
const modeles: Modele[] = ordre.map((f) => {
  const r = (recettes as Record<string, any>)[f];
  return { id: f, kind: 'famille', name: r.subtitle.replace(/^Famille /, ''), color: r.couleur, preview: url(`/images/modeles/${f}.webp`), recette: r };
});
// … et une par copain, dans toutes ses tenues (familles.py --copains), par ordre alphabétique
for (const [slug, r] of Object.entries(recettesCopains as Record<string, any>).sort((a, b) => a[1].members[0].name.localeCompare(b[1].members[0].name))) {
  modeles.push({ id: `copain-${slug}`, kind: 'copain', name: r.members[0].name, color: '#f7e39c', preview: url(`/images/modeles/copains/${slug}.webp`), recette: r });
}
---

<PageShell
  title="Créer mon affiche"
  eyebrow="Configurateur · version test"
  intro="Choisis tes copains, leur tenue, le style et le format : ton affiche se compose en direct."
  accent="yellow"
>
  <PosterConfigurator client:load roster={roster} />
  <ModelesAffiches client:visible modeles={modeles} />
</PageShell>
