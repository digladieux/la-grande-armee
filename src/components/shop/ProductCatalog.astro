---
/**
 * Page Boutique : catalogue détaillé (une grande rangée par produit, image et texte en alternance).
 * L'accueil garde la grille compacte (ProductGrid) : les deux ne se ressemblent pas.
 */
import type { Product } from '@/data/products';
import CTA from '@/components/ui/CTA.astro';
import { url } from '@/lib/url';

interface Props {
  products: Product[];
}
const { products } = Astro.props;
---

<ol class="catalog">
  {products.map((p, i) => (
    <li class:list={['catalog__item', { 'is-flipped': i % 2 === 1 }]} style={`--c: var(--${p.color})`} id={p.slug}>
      <div class="catalog__media">
        {p.image ? (
          <img src={url(`/${p.image}`)} alt="" width="1000" height="1000" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
        ) : (
          <div class="catalog__placeholder" aria-hidden="true">
            <span class="hand">Bientôt…</span>
          </div>
        )}
      </div>
      <div class="catalog__body">
        <div class="catalog__top">
          <span class="catalog__num">{String(i + 1).padStart(2, '0')}</span>
          {p.tag && <span class="catalog__tag">{p.tag}</span>}
        </div>
        <h2 class="catalog__name">{p.name}</h2>
        {p.description && <p class="catalog__desc">{p.description}</p>}
        {p.details && (
          <ul class="catalog__details">
            {p.details.map((d) => <li>{d}</li>)}
          </ul>
        )}
        <div class="catalog__foot">
          <span class="catalog__price">{p.price ?? 'Prix à venir'}</span>
          {p.cta && <CTA href={p.cta.href}>{p.cta.label}</CTA>}
        </div>
      </div>
    </li>
  ))}
</ol>

<style>
  .catalog {
    display: grid;
    gap: clamp(28px, 5vw, 56px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .catalog__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(20px, 4vw, 56px);
    padding: clamp(16px, 2.5vw, 28px);
    border: var(--border);
    border-radius: calc(var(--radius) * 1.6);
    background: color-mix(in srgb, var(--c) 18%, var(--paper));
  }
  .catalog__item.is-flipped .catalog__media {
    order: 2;
  }
  .catalog__media {
    overflow: hidden;
    aspect-ratio: 1;
    border: var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--c) 55%, var(--paper));
    box-shadow: var(--shadow);
  }
  .catalog__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .catalog__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
  }
  .catalog__placeholder span {
    font-size: 2.4rem;
    transform: rotate(-4deg);
  }
  .catalog__top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .catalog__num {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1;
    color: color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .catalog__tag {
    padding: 3px 10px;
    border: var(--border);
    border-radius: 999px;
    background: var(--paper);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .catalog__name {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
  }
  .catalog__desc {
    margin-top: 14px;
    max-width: 46ch;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .catalog__details {
    display: grid;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }
  .catalog__details li {
    position: relative;
    padding-left: 26px;
    font-weight: 600;
  }
  .catalog__details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 14px;
    height: 14px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--c);
  }
  .catalog__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
    margin-top: 24px;
  }
  .catalog__price {
    font-weight: 700;
    color: var(--ink-soft);
  }
  @media (max-width: 760px) {
    .catalog__item {
      grid-template-columns: 1fr;
    }
    .catalog__item.is-flipped .catalog__media {
      order: 0;
    }
  }
</style>
