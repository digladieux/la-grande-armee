---
/**
 * Grille compacte des produits (accueil) ; la page Boutique a son catalogue détaillé (ProductCatalog).
 * Un produit sans page propre renvoie vers `fallbackHref` ; sans lui, sa vignette n'est pas un lien.
 */
import type { Product } from '@/data/products';
import { url } from '@/lib/url';

interface Props {
  products: Product[];
  fallbackHref?: string;
}
const { products, fallbackHref } = Astro.props;
const href = (p: Product) => {
  const h = p.href ?? fallbackHref;
  return h ? url(h) : undefined;
};
---

<ul class="shop__grid">
  {products.map((product) => {
    const Tag = href(product) ? 'a' : 'div';
    return (
      <li>
        <Tag class:list={['product', { 'product--static': !href(product) }]} href={href(product)} style={`--c: var(--${product.color})`}>
          <div class:list={['product__media', { 'product__media--photo': product.image }]}>
            {product.image ? (
              <img src={url(`/${product.image}`)} alt="" width="1000" height="1000" loading="lazy" decoding="async" />
            ) : (
              <div class="product__placeholder" aria-hidden="true">
                <svg viewBox="0 0 48 48" width="44" height="44">
                  <rect x="10" y="6" width="28" height="36" rx="2" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.4" />
                  <path d="M16 32l6-8 5 6 3-4 4 6z" fill="var(--ink)" />
                  <circle cx="30" cy="16" r="3" fill="var(--ink)" />
                </svg>
              </div>
            )}
            {product.tag && <span class="product__tag">{product.tag}</span>}
          </div>
          <div class="product__body">
            <h3 class="product__name">{product.name}</h3>
            <p class="product__price">{product.price ?? 'Prix à venir'}</p>
          </div>
        </Tag>
      </li>
    );
  })}
</ul>

<style>
  .shop__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .product {
    display: block;
    height: 100%;
    text-decoration: none;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--paper);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .product.product--static:hover {
    transform: none;
    box-shadow: none;
  }
  .product:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow);
  }
  .product__media {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    padding: 12%;
    background: color-mix(in srgb, var(--c) 55%, var(--paper));
    border-bottom: var(--border);
  }
  /* Visuel d'affiche : remplit toute la vignette, net (ni marge, ni rotation) */
  .product__media--photo {
    padding: 0;
    overflow: hidden;
  }
  .product__media--photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .product:hover .product__media--photo img {
    transform: scale(1.04);
  }
  .product__placeholder {
    display: grid;
    place-items: center;
    width: 60%;
    aspect-ratio: 3 / 4;
    border: 2px dashed var(--ink);
    border-radius: var(--radius-sm);
    background: rgb(255 252 244 / 0.5);
    transform: rotate(2deg);
  }
  .product__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 3px 10px;
    border: var(--border);
    border-radius: 999px;
    background: var(--paper);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .product__body {
    padding: 14px 16px 16px;
  }
  .product__name {
    font-size: 1.2rem;
    line-height: 1.05;
  }
  .product__price {
    margin-top: 6px;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  @media (max-width: 900px) {
    .shop__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }
</style>
