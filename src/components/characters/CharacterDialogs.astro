---
/**
 * Fenêtres « fiche personnage » : un carrousel des différents personnages
 * qu'incarne un copain (un par famille). S'ouvrent au clic sur tout élément
 * portant `data-character-open="<slug>"` (ex. CharacterCard).
 * À placer une fois par page qui affiche des cartes.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { Character, Look } from '@/data/characters';
import { families } from '@/data/families';
import CharacterPortrait from './CharacterPortrait.astro';
import { url } from '@/lib/url';

interface Props {
  characters: Character[];
}

const list = Astro.props.characters.filter((c) => c.looks?.length);

const publicFile = (path: string) => existsSync(join(process.cwd(), 'public', path));

/** Carte d'origine avec son décor (<famille>-decor.webp, scripts/decors.py), même cadre 708×1068. */
const decorImage = (look: Look) => {
  const path = look.image.replace('-blanc.png', '-decor.webp');
  return path !== look.image && publicFile(path) ? path : undefined;
};

/** Lueur colorée de la carte prolongée tout autour (<famille>-fond.webp, à poser derrière la carte avec décor). */
const glowImage = (look: Look) => {
  const decor = decorImage(look);
  return decor && publicFile(decor.replace('-decor.webp', '-fond.webp')) ? decor.replace('-decor.webp', '-fond.webp') : undefined;
};

/** Carte avec décor si elle existe, sinon illustration sans fond (<famille>-plein.png), sinon l'illustration d'origine. */
const artImage = (look: Look) => {
  const decor = decorImage(look);
  if (decor) return decor;
  const plein = look.cutout?.replace('-cutout.png', '-plein.png');
  return plein && existsSync(join(process.cwd(), 'public', plein)) ? plein : look.image;
};

/** Calque de la bulle de paroles d'origine (<famille>-bulle.png), même cadre que l'illustration. Inutile sur la carte avec décor (bulle déjà dessinée). */
const bubbleLayer = (look: Look) => {
  if (decorImage(look)) return undefined;
  const path = look.image.replace('-blanc.png', '-bulle.png');
  return path !== look.image && existsSync(join(process.cwd(), 'public', path)) ? path : undefined;
};
---

{list.map((character) => {
  const looks = character.looks!;
  return (
    <dialog class="cdialog" data-character-dialog={character.slug} aria-labelledby={`cdialog-title-${character.slug}`}>
      <div class="cdialog__panel">
        <button class="cdialog__close" type="button" data-close aria-label="Fermer">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
        </button>

        <header class="cdialog__head">
          <h2 class="cdialog__title" id={`cdialog-title-${character.slug}`}>{character.name}</h2>
          <p class="cdialog__sub hand">
            {looks.length > 1 ? `${looks.length} personnages, ${looks.length} familles… et toujours la même tête !` : character.tagline}
          </p>
        </header>

        <div class="cdialog__stage">
          <button class="cdialog__arrow cdialog__arrow--prev" type="button" data-prev aria-label="Personnage précédent">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>

          <ul class="cdialog__track" data-track>
            {looks.map((look, i) => {
              const family = families[look.family];
              const bubble = bubbleLayer(look);
              const glow = glowImage(look);
              return (
                <li class="cdialog__slide" aria-label={`${i + 1} sur ${looks.length} : famille ${family.name}`}>
                  <div class="cdialog__art">
                    {/* La couleur de fond de la carte déborde sur tout le cadre (plus d'effet d'encart) */}
                    {glow && <span class="cdialog__glow" style={`background-image: url('${url(`/${glow}`)}')`} aria-hidden="true" />}
                    <img src={url(`/${artImage(look)}`)} alt={`${character.name}, famille ${family.name}`} loading="lazy" decoding="async" />
                    {/* Vidéo posée sur la carte : la carte d'origine reste visible un instant, puis l'animation démarre en fondu */}
                    {look.video && (
                      <video
                        class="cdialog__video"
                        data-src={url(`/${look.video}`)}
                        muted
                        loop
                        playsinline
                        preload="none"
                        aria-label={`${character.name}, famille ${family.name} (animation)`}
                      />
                    )}
                    {bubble && <img class="cdialog__bubble" src={url(`/${bubble}`)} alt={look.bubble ?? ''} loading="lazy" decoding="async" />}
                  </div>
                  <p class="cdialog__family" style={`--c: ${family.bg}`}>
                    <span class="cdialog__family-label">Famille</span>
                    <strong>{family.name}</strong>
                    {look.role && <span>{look.role}</span>}
                  </p>
                </li>
              );
            })}
          </ul>

          <button class="cdialog__arrow cdialog__arrow--next" type="button" data-next aria-label="Personnage suivant">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>

        {looks.length > 1 && (
          <ul class="cdialog__thumbs" data-thumbs>
            {looks.map((look, i) => (
              <li>
                <button type="button" class="cdialog__thumb" data-goto={i} style={`--c: ${families[look.family].bg}`} aria-label={`Famille ${families[look.family].name}`}>
                  <CharacterPortrait look={look} alt="" />
                </button>
              </li>
            ))}
          </ul>
        )}
      </div>
    </dialog>
  );
})}

<script>
  const dialogs = new Map<string, HTMLDialogElement>();
  document.querySelectorAll<HTMLDialogElement>('[data-character-dialog]').forEach((dialog) => {
    dialogs.set(dialog.dataset.characterDialog!, dialog);

    const track = dialog.querySelector<HTMLElement>('[data-track]')!;
    const thumbList = dialog.querySelector<HTMLElement>('[data-thumbs]');
    const allSlides = [...track.children] as HTMLElement[];
    const allThumbs = [...dialog.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    let slides = allSlides;
    let thumbs = allThumbs;
    // Le personnage cliqué passe en tête, les autres suivent dans l'ordre habituel
    const putFirst = (first: number) => {
      const order = [first, ...allSlides.keys()].filter((v, i, a) => a.indexOf(v) === i);
      slides = order.map((i) => allSlides[i]);
      thumbs = order.map((i) => allThumbs[i]);
      track.append(...slides);
      thumbList?.append(...thumbs.map((t) => t.parentElement!));
      thumbs.forEach((t, i) => (t.dataset.goto = String(i)));
      slides.forEach((s, i) => s.setAttribute('aria-label', s.getAttribute('aria-label')!.replace(/^\d+/, String(i + 1))));
    };
    const prev = dialog.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-next]')!;
    let index = 0;

    // Vidéos : la carte d'origine s'affiche d'abord, l'animation démarre 1 s après
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const VIDEO_DELAY = 1000;
    let videoTimer = 0;
    // Masquage du dessin en style direct : iOS Safari ne l'appliquait pas toujours via le CSS
    const setDrawingHidden = (v: HTMLVideoElement, hidden: boolean) => {
      const img = v.parentElement?.querySelector<HTMLImageElement>('img:not(.cdialog__bubble)');
      if (img) img.style.visibility = hidden ? 'hidden' : '';
    };
    const stopVideos = () => {
      clearTimeout(videoTimer);
      dialog.querySelectorAll<HTMLVideoElement>('video[data-src]').forEach((v) => {
        v.pause();
        v.classList.remove('is-playing');
        v.parentElement?.classList.remove('is-playing');
        setDrawingHidden(v, false);
        if (v.src) v.currentTime = 0;
      });
    };
    const startVideo = () => {
      stopVideos();
      const v = slides[index]?.querySelector<HTMLVideoElement>('video[data-src]');
      if (!v || reduceMotion.matches || !dialog.open) return;
      if (!v.src) {
        v.src = v.dataset.src!;
        v.load();
      }
      videoTimer = window.setTimeout(() => {
        v.play()
          .then(() => {
            v.classList.add('is-playing');
            // La vidéo est sur fond blanc : la lueur de la carte s'efface en même temps
            v.parentElement?.classList.add('is-playing');
            // Dessin masqué une fois le fondu de la vidéo terminé (pas de flash blanc entre les deux)
            v.addEventListener('transitionend', () => v.classList.contains('is-playing') && setDrawingHidden(v, true), { once: true });
          })
          .catch(() => {});
      }, VIDEO_DELAY);
    };

    // Carrousel en boucle : après la dernière carte, on revient à la première (et inversement)
    const goTo = (i: number, smooth = true) => {
      index = (i + slides.length) % slides.length;
      track.scrollTo({ left: index * track.clientWidth, behavior: smooth ? 'smooth' : 'auto' });
      render();
    };
    const render = () => {
      thumbs.forEach((t, i) => t.setAttribute('aria-current', String(i === index)));
      // Garde la miniature active visible dans la rangée (sans faire défiler la fenêtre)
      const t = thumbs[index]?.parentElement;
      if (thumbList && t) thumbList.scrollTo({ left: t.offsetLeft - (thumbList.clientWidth - t.offsetWidth) / 2, behavior: 'smooth' });
      prev.hidden = next.hidden = slides.length < 2;
      startVideo();
    };

    prev.addEventListener('click', () => goTo(index - 1));
    next.addEventListener('click', () => goTo(index + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => goTo(Number(t.dataset.goto))));
    track.addEventListener(
      'scroll',
      () => {
        const i = Math.round(track.scrollLeft / track.clientWidth);
        if (i !== index) {
          index = i;
          render();
        }
      },
      { passive: true },
    );
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') goTo(index - 1);
      if (e.key === 'ArrowRight') goTo(index + 1);
    });
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    // Clic sur le fond (hors panneau) = fermeture
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      stopVideos();
    });
    dialog.addEventListener('open-at', (e) => {
      putFirst((e as CustomEvent<number>).detail ?? 0);
      goTo(0, false);
    });
    render();
  });

  const open = (slug: string, look = 0) => {
    const dialog = dialogs.get(slug);
    if (!dialog) return false;
    dialog.showModal();
    document.body.style.overflow = 'hidden';
    dialog.dispatchEvent(new CustomEvent('open-at', { detail: look }));
    return true;
  };

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-character-open]');
    if (trigger && open(trigger.dataset.characterOpen!, Number(trigger.dataset.characterLook ?? 0))) e.preventDefault();
  });

  // Lien direct /personnages#dim → ouvre la fiche
  const hash = decodeURIComponent(location.hash.slice(1));
  if (hash) open(hash);
</script>

<style>
  .cdialog {
    width: min(760px, calc(100vw - 24px));
    max-height: calc(100dvh - 24px);
    padding: 0;
    border: var(--border);
    border-radius: calc(var(--radius) * 1.5);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    overflow: hidden;
  }
  .cdialog::backdrop {
    background: rgb(22 20 18 / 0.55);
    backdrop-filter: blur(3px);
  }
  .cdialog[open] {
    animation: dialog-in 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
  }
  .cdialog__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 28px);
    padding: clamp(18px, 3vw, 28px);
    overflow-x: hidden;
    overflow-y: auto;
  }
  .cdialog__close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: var(--border);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }
  .cdialog__close:hover {
    background: var(--yellow);
  }
  .cdialog__head {
    padding-right: 52px;
  }
  .cdialog__title {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
  }
  .cdialog__sub {
    margin-top: 4px;
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    transform: rotate(-1deg);
  }
  .cdialog__stage {
    position: relative;
    margin-top: 16px;
  }
  .cdialog__track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border: var(--border);
    border-radius: var(--radius);
    background: #fff;
  }
  .cdialog__track::-webkit-scrollbar {
    display: none;
  }
  .cdialog__slide {
    position: relative;
    /* La lueur de la carte déborde de l'illustration : elle reste dans sa diapositive */
    overflow: hidden;
    isolation: isolate;
    flex: 0 0 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 12px 12px 16px;
    scroll-snap-align: center;
  }
  .cdialog__art > img:not(.cdialog__bubble) {
    display: block;
    width: auto;
    height: min(50dvh, 480px);
    object-fit: contain;
    transition: opacity 0.45s ease;
  }
  .cdialog__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.45s ease;
    aspect-ratio: 708 / 1068;
    /* Fond déjà blanc dans le fichier (scripts/video/blanchir.swift) : pas de filtre CSS, ignoré par Safari sur une <video> */
  }
  /* Illustration + calque de la bulle d'origine, superposés au pixel près */
  .cdialog__art {
    position: relative;
  }
  /* Fond prolongé : même cadre que la carte, étendu de 1,5 largeur et 1 hauteur de chaque côté (scripts/decors.py) */
  .cdialog__glow {
    position: absolute;
    top: -100%;
    bottom: -100%;
    left: -150%;
    right: -150%;
    z-index: -1;
    background: center / 100% 100% no-repeat;
    transition: opacity 0.45s ease;
  }
  .cdialog__art.is-playing .cdialog__glow {
    opacity: 0;
  }
  .cdialog__video.is-playing {
    opacity: 1;
  }
  .cdialog__bubble {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .cdialog__family {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px 14px;
    border: var(--border);
    border-radius: var(--radius-sm);
    background: var(--c);
    box-shadow: var(--shadow-sm);
    transform: rotate(-2deg);
    line-height: 1.1;
  }
  .cdialog__family-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .cdialog__family strong {
    /* Place pour les accents des majuscules (BOTÉFRAGILE) sous le mot « Famille » */
    margin-top: 0.3em;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .cdialog__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: var(--border);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transform: translateY(-50%);
    transition: opacity 0.2s ease;
  }
  .cdialog__arrow[hidden] {
    display: none;
  }
  .cdialog__arrow--prev {
    left: -12px;
  }
  .cdialog__arrow--next {
    right: -12px;
  }
  /* Rangée défilante à part : trop large sur mobile, elle ne doit pas élargir la fenêtre */
  .cdialog__thumbs {
    display: flex;
    justify-content: safe center;
    gap: 10px;
    margin: 16px 0 0;
    padding: 4px 2px 8px;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cdialog__thumbs::-webkit-scrollbar {
    display: none;
  }
  .cdialog__thumbs > li {
    flex: none;
  }
  .cdialog__thumb {
    display: block;
    width: 64px;
    padding: 0;
    border: var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--c);
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .cdialog__thumb:hover {
    opacity: 0.85;
  }
  .cdialog__thumb[aria-current='true'] {
    opacity: 1;
    transform: translateY(-3px);
    box-shadow: 0 5px 0 var(--c), 0 5px 0 2px var(--ink);
  }
  @media (max-width: 560px) {
    .cdialog__arrow {
      width: 40px;
      height: 40px;
    }
    .cdialog__arrow--prev {
      left: 6px;
    }
    .cdialog__arrow--next {
      right: 6px;
    }
    .cdialog__art > img:not(.cdialog__bubble) {
      height: min(50dvh, 460px);
    }
    .cdialog__thumb {
      width: 56px;
    }
  }
</style>
