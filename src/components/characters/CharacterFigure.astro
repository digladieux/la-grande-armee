---
/**
 * Affiche l'illustration d'un personnage.
 * - `character.image` renseigné → PNG détouré de l'artiste.
 * - sinon → silhouette provisoire dessinée en SVG (à remplacer).
 */
import type { Character } from '@/data/characters';
import { url } from '@/lib/url';

interface Props {
  character: Character;
  class?: string;
  eager?: boolean;
}

const { character, class: className, eager = false } = Astro.props;
const p = character.placeholder ?? {};
const shirt = `var(--${character.color === 'cream' ? 'yellow' : character.color})`;
---

{character.image ? (
  <img
    class:list={['figure', className]}
    src={url(`/${character.image}`)}
    alt={character.name}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
) : (
  <svg class:list={['figure', 'figure--placeholder', className]} viewBox="0 0 200 280" role="img" aria-label={`${character.name} (illustration à venir)`}>
    <g stroke="var(--ink)" stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
      {p.hair === 'long' && (
        <path d="M52 100 C 46 44, 154 44, 148 100 L 154 156 L 130 146 L 138 104 C 120 84, 80 84, 62 104 L 70 146 L 46 156 Z" fill="#7a5436" />
      )}
      <path d="M26 282 C 26 206, 52 172, 100 170 C 148 172, 174 206, 174 282 Z" fill={shirt} />
      <path d="M78 172 L 100 204 L 122 172" fill="none" />
      <rect x="88" y="138" width="24" height="36" rx="6" fill="#f3d2b8" />
      <ellipse cx="54" cy="104" rx="9" ry="12" fill="#f3d2b8" />
      <ellipse cx="146" cy="104" rx="9" ry="12" fill="#f3d2b8" />
      <ellipse cx="100" cy="100" rx="44" ry="50" fill="#f3d2b8" />
      {p.beard && <path d="M57 106 C 58 158, 142 158, 143 106 C 132 132, 68 132, 57 106 Z" fill="#3d2f27" />}
      {p.hair === 'short' && (
        <path d="M56 96 C 52 54, 80 42, 104 44 C 130 46, 150 60, 144 96 C 136 76, 120 68, 100 70 C 80 70, 64 78, 56 96 Z" fill="#2c231e" />
      )}
      {p.hair === 'spiky' && (
        <path d="M54 94 L 58 50 L 74 66 L 80 32 L 96 58 L 108 26 L 118 58 L 134 36 L 136 66 L 152 54 L 146 94 C 130 72, 70 72, 54 94 Z" fill="#f2c94c" />
      )}
      {p.hair === 'long' && (
        <path d="M56 98 C 54 54, 146 54, 144 98 C 128 74, 72 74, 56 98 Z" fill="#7a5436" />
      )}
      {p.cap && (
        <>
          <path d="M54 86 C 54 44, 146 44, 146 86 Z" fill="var(--coral)" />
          <path d="M118 84 C 140 80, 162 82, 174 90 C 160 98, 134 96, 116 92 Z" fill="var(--coral)" />
        </>
      )}
      {p.glasses ? (
        <>
          <rect x="64" y="90" width="31" height="19" rx="7" fill="var(--ink)" />
          <rect x="105" y="90" width="31" height="19" rx="7" fill="var(--ink)" />
          <path d="M95 97 H 105" fill="none" />
        </>
      ) : (
        <>
          <circle cx="82" cy="100" r="4.5" fill="var(--ink)" stroke="none" />
          <circle cx="118" cy="100" r="4.5" fill="var(--ink)" stroke="none" />
          <path d="M72 88 Q 82 82 92 87 M108 87 Q 118 82 128 88" fill="none" stroke-width="3.5" />
        </>
      )}
      <path d="M86 126 Q 100 138 114 126" fill="none" stroke={p.beard ? '#f3d2b8' : 'var(--ink)'} />
    </g>
  </svg>
)}

<style>
  .figure {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
  }
</style>
