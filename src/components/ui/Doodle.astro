---
/** Petits éléments dessinés (étoiles, éclats) pour l'aspect artisanal. */
interface Props {
  shape?: 'sparkle' | 'burst' | 'squiggle';
  size?: number;
  color?: string;
  class?: string;
}
const { shape = 'sparkle', size = 40, color = 'var(--yellow)', class: className } = Astro.props;
---

<svg class:list={['doodle', className]} viewBox="0 0 48 48" width={size} height={size} aria-hidden="true">
  {shape === 'sparkle' && (
    <path d="M24 3 C 26 16, 32 22, 45 24 C 32 26, 26 32, 24 45 C 22 32, 16 26, 3 24 C 16 22, 22 16, 24 3 Z" fill={color} stroke="var(--ink)" stroke-width="2.2" stroke-linejoin="round" />
  )}
  {shape === 'burst' && (
    <g stroke="var(--ink)" stroke-width="2.6" stroke-linecap="round">
      <path d="M24 4v10M24 34v10M4 24h10M34 24h10M10 10l7 7M31 31l7 7M38 10l-7 7M17 31l-7 7" />
    </g>
  )}
  {shape === 'squiggle' && (
    <path d="M3 30 C 9 14, 15 14, 18 26 S 27 38, 31 24 S 40 10, 45 20" fill="none" stroke={color} stroke-width="3.5" stroke-linecap="round" />
  )}
</svg>
