---
/**
 * Mockup d'affiche encadrée.
 * - `image` : affiche finie (ex. couverture du jeu).
 * - sinon : affiche composée à partir d'un personnage + titre (préfigure le configurateur).
 */
import type { Character } from '@/data/characters';
import CharacterFigure from '@/components/characters/CharacterFigure.astro';
import { url } from '@/lib/url';

interface Props {
  image?: string;
  alt?: string;
  character?: Character;
  title?: string;
  subtitle?: string;
  frame?: 'wood' | 'black' | 'white';
  class?: string;
}

const {
  image,
  alt = 'Affiche La Grande Armée',
  character,
  title = 'La Grande Armée',
  subtitle,
  frame = 'wood',
  class: className,
} = Astro.props;
---

<figure class:list={['poster', `poster--${frame}`, className]}>
  <div class="poster__mat">
    {image ? (
      <img class="poster__img" src={url(`/${image}`)} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <div class="poster__composed stripes" role="img" aria-label={`Exemple d'affiche : ${title}`}>
        <div class="poster__title">
          <strong>{title}</strong>
          {subtitle && <span>{subtitle}</span>}
        </div>
        {character && (
          <div class="poster__character">
            <CharacterFigure character={character} full />
          </div>
        )}
      </div>
    )}
  </div>
</figure>

<style>
  .poster {
    margin: 0;
    padding: 14px;
    border-radius: 4px;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.4) inset,
      0 24px 40px -18px rgb(22 20 18 / 0.45),
      0 6px 12px -6px rgb(22 20 18 / 0.3);
  }
  .poster--wood {
    background: linear-gradient(135deg, #d9a86c, #b98249 45%, #d4a266);
  }
  .poster--black {
    background: #1d1b19;
  }
  .poster--white {
    background: #fdfdfb;
    outline: 1px solid var(--line);
  }
  .poster__mat {
    padding: 8%;
    background: #fbfaf6;
    box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.18);
  }
  .poster__img,
  .poster__composed {
    width: 100%;
    aspect-ratio: 7 / 10;
    object-fit: cover;
  }
  .poster__composed {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-size: 140% 140%;
  }
  .poster__title {
    position: relative;
    z-index: 1;
    padding: 12% 8% 0;
    text-align: center;
  }
  .poster__title strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 3.4vw, 2.4rem);
    line-height: 0.95;
    text-transform: uppercase;
    text-shadow: 0 0 12px rgb(255 252 244 / 0.9);
  }
  .poster__title span {
    display: inline-block;
    margin-top: 6px;
    padding: 2px 10px;
    background: var(--paper);
    border-radius: 999px;
    font-family: var(--font-hand);
    font-size: clamp(0.95rem, 1.8vw, 1.25rem);
    font-weight: 700;
  }
  .poster__character {
    flex: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 6% 16% 0;
  }
</style>
