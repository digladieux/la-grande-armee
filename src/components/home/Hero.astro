---
/**
 * Hero de la home : titre + composition de groupe des personnages.
 * Les personnages se chevauchent, avec des tailles différentes, devant une
 * « affiche » à bandes diagonales. Sur mobile, les deux extrémités sont masquées.
 */
import type { Character } from '@/data/characters';
import { heroBusts, type HeroBust } from '@/data/hero-busts';
import CTA from '@/components/ui/CTA.astro';
import Annotation from '@/components/ui/Annotation.astro';
import Doodle from '@/components/ui/Doodle.astro';
import { url } from '@/lib/url';

interface Props {
  characters: Character[];
}

/**
 * Tirage des bustes : au hasard, un copain différent par place. Même code côté serveur
 * (première image) et côté navigateur (nouveau tirage à chaque chargement).
 */
const N = 7;
const ORDER = [3, 2, 4, 1, 5, 0, 6]; // du centre vers les bords
function draw(pool: HeroBust[], random: () => number): HeroBust[] {
  const shuffled = [...pool].map((b) => ({ b, r: random() })).sort((x, y) => x.r - y.r).map((x) => x.b);
  const picked: HeroBust[] = [];
  {
    for (const b of shuffled) {
      if (picked.length >= N) break;
      if (picked.includes(b) || picked.some((p) => p.slug === b.slug)) continue;
      picked.push(b);
    }
  }
  const group: HeroBust[] = new Array(N);
  picked.forEach((b, i) => (group[ORDER[i]] = b));
  return group;
}
let seed = 7;
const group = draw(heroBusts, () => ((seed = (seed * 9301 + 49297) % 233280) / 233280));
const pool = heroBusts.map((b) => ({ ...b, src: url(`/${b.src}`) }));

// Tous à la même taille (têtes égalisées par buste : k, o) ; léger zigzag vertical, profondeur vers le centre.
const mid = (N - 1) / 2;
const layout = group.map((_, i) => {
  const d = Math.abs(i - mid) / mid;
  return { y: i % 2 ? 4 : 0, z: Math.round(10 - d * 8) };
});
const vars = (b: HeroBust) => `--k:${b.k}; --ox:${b.o[0]}%; --oy:${b.o[1]}%`;
---

<section class="hero">
  <div class="container hero__intro">
    <span class="hero__pill">Des souvenirs accrochés au mur</span>
    <h1 class="hero__title">
      {/* Titre dessiné (typographie de la marque, vectorisée par scripts/titre-svg.py) */}
      <span class="sr-only">La Grande Armée</span>
      <img class="hero__title-line" src={url('/images/titre-la-grande.svg')} alt="" />
      <img class="hero__title-line hero__title-line--2" src={url('/images/titre-armee.svg')} alt="" />
      <Doodle class="hero__spark hero__spark--l" shape="sparkle" size={46} color="var(--yellow)" />
      <Doodle class="hero__spark hero__spark--r" shape="burst" size={44} />
    </h1>
    <p class="hero__baseline">La bande de copains qu'on n'a <span class="mark">jamais choisie</span>.</p>
    <div class="hero__ctas">
      <CTA href="/creer-mon-affiche">Créer mon affiche</CTA>
      <CTA href="#la-bande" variant="secondary" arrow={false}>Découvrir la bande</CTA>
    </div>
  </div>

  <div class="hero__stage container">

    <Annotation class="hero__note hero__note--1" arrow="down-right" rotate={-6}>des soirées, des souvenirs</Annotation>
    <Annotation class="hero__note hero__note--2" arrow="down-left" rotate={5}>une quinzaine de copains</Annotation>
    <Annotation class="hero__note hero__note--3" arrow="down-left" rotate={-3}>aucun n'a été choisi !</Annotation>

    {/* Les copains sont DANS l'encart : coupés par son bord bas, la tête peut dépasser en haut */}
    <div class="hero__scene">
      <div class="hero__band stripes" aria-hidden="true"></div>
      <ul class="hero__group" aria-label="La bande" style={`--n:${N}`} data-hero-group data-pool={JSON.stringify(pool)}>
        {group.map((b, i) => {
          const l = layout[i];
          return (
            <li class="hero__member" style={`--y:${l.y}%; --z:${l.z}; --d:${i * 70}ms`}>
              <img class="figure" src={url(`/${b.src}`)} alt={b.name} loading="eager" decoding="async" data-hero-slot={i} style={vars(b)} />
            </li>
          );
        })}
      </ul>
      <div class="hero__cadre" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  // Nouveau tirage à chaque chargement de page (mêmes règles que côté serveur)
  type Bust = { slug: string; name: string; family: string; src: string; k: number; o: [number, number] };
  const groupEl = document.querySelector<HTMLElement>('[data-hero-group]');
  if (groupEl) {
    const pool: Bust[] = JSON.parse(groupEl.dataset.pool!);
    const ORDER = [3, 2, 4, 1, 5, 0, 6];
    const shuffled = pool.map((b) => ({ b, r: Math.random() })).sort((x, y) => x.r - y.r).map((x) => x.b);
    const picked: Bust[] = [];
    {
      for (const b of shuffled) {
        if (picked.length >= ORDER.length) break;
        if (picked.includes(b) || picked.some((p) => p.slug === b.slug)) continue;
          picked.push(b);
      }
    }
    picked.forEach((b, i) => {
      const img = groupEl.querySelector<HTMLImageElement>(`[data-hero-slot="${ORDER[i]}"]`);
      if (img) {
        img.src = b.src;
        img.alt = b.name;
        img.style.setProperty('--k', String(b.k));
        img.style.setProperty('--ox', `${b.o[0]}%`);
        img.style.setProperty('--oy', `${b.o[1]}%`);
      }
    });
  }
</script>

<style>
  .hero {
    position: relative;
    padding-top: clamp(40px, 7vw, 80px);
    overflow: hidden;
  }

  /* ── Intro ── */
  .hero__intro {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 18px;
  }
  .hero__pill {
    /* légèrement remonté : plus d'air entre le bandeau et le grand titre */
    margin: -12px 0 14px;
    padding: 6px 16px;
    border: var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--purple) 40%, var(--paper));
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hero__title {
    position: relative;
    width: fit-content;
    margin-inline: auto;
    font-size: clamp(2.6rem, 8vw, 6rem); /* taille de référence des étincelles */
    line-height: 0;
  }
  .hero__title-line {
    display: block;
    height: clamp(3.4rem, 11vw, 8.4rem);
    width: auto;
    margin: 0 auto;
  }
  /* « ARMÉE » : son dessin inclut l'accent du É (+16 % de hauteur) → mêmes capitales que « LA GRANDE » */
  .hero__title-line--2 {
    height: calc(clamp(3.4rem, 11vw, 8.4rem) * 1.16);
    margin-top: 0;
  }
  :global(.hero__spark) {
    position: absolute;
  }
  /* Étincelles posées en dehors du titre, sans cacher les lettres */
  :global(.hero__spark--l) {
    left: -0.95em;
    top: -0.45em;
    transform: rotate(-12deg);
  }
  :global(.hero__spark--r) {
    right: -0.95em;
    top: -0.5em;
  }
  .hero__baseline {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1.1;
    transform: rotate(-1.5deg);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }

  /* ── Scène de groupe ── */
  .hero__stage {
    position: relative;
    margin-top: clamp(24px, 5vw, 56px);
    padding-top: clamp(40px, 6vw, 70px);
  }
  /* Encart à bandes, légèrement penché ; les copains sont posés dedans */
  .hero__scene {
    --r: clamp(20px, 3vw, 36px);
    position: relative;
    margin: 0 2% 18px;
    transform: rotate(-1.5deg);
  }
  .hero__band,
  .hero__cadre {
    position: absolute;
    inset: 30% 0 0;
    border: var(--border);
    border-radius: var(--r);
    pointer-events: none;
  }
  .hero__band {
    background-size: 100% 100%;
    background-image: repeating-linear-gradient(
      -50deg,
      var(--green) 0 7%,
      var(--coral) 7% 14%,
      var(--cream) 14% 21%,
      var(--purple) 21% 28%,
      var(--yellow) 28% 35%,
      var(--orange) 35% 42%,
      var(--blue) 42% 49%
    );
  }
  /* Bords bas et côtés redessinés par-dessus les copains (le haut reste derrière les têtes) */
  .hero__cadre {
    z-index: 20;
    border-top-color: transparent;
  }
  .hero__group {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    margin: 0;
    padding: 0 1%;
    list-style: none;
    /* coupé au bord intérieur de l'encart (bas et côtés) ; rien au-dessus */
    clip-path: inset(-60% 2px 2px 2px round 0 0 var(--r) var(--r));
  }
  .hero__member {
    flex: 0 0 auto;
    width: calc(100% / var(--n) * 1.3);
    margin-inline: calc(100% / var(--n) * -0.15);
    aspect-ratio: 200 / 280;
    z-index: var(--z);
    /* le bas du buste (coupé dans la vidéo) passe sous le bord de l'encart */
    transform: translateY(calc(var(--y) + 5%)) rotate(1.5deg);
    transform-origin: bottom center;
    animation: pop-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: var(--d);
  }
  .hero__member img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
    /* même taille de tête pour tous : mise à l'échelle autour du visage */
    transform: scale(var(--k, 1));
    transform-origin: var(--ox, 50%) var(--oy, 30%);
    /* bords du cadrage (bras, panneau coupés net) adoucis en fondu */
    --fondu: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 5%);
    -webkit-mask-image: var(--fondu);
    -webkit-mask-composite: source-in;
    mask-image: var(--fondu);
    mask-composite: intersect;
  }
  @media (hover: hover) {
    .hero__member:hover {
      animation: wiggle 0.5s ease;
    }
  }

  /* ── Annotations ── */
  :global(.hero__note) {
    position: absolute;
    z-index: 6;
  }
  :global(.hero__note--1) {
    left: calc(var(--gutter) + 1%);
    top: 4%;
  }
  :global(.hero__note--2) {
    right: calc(var(--gutter) + 4%);
    top: 0;
  }
  :global(.hero__note--3) {
    right: calc(var(--gutter) + 26%);
    top: 14%;
  }

  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(calc(var(--y) + 32%)) rotate(1.5deg);
    }
  }
  @keyframes wiggle {
    0%, 100% { rotate: 0deg; }
    30% { rotate: -3deg; }
    60% { rotate: 2.5deg; }
  }

  @media (max-width: 720px) {
    .hero__group {
      --n-mobile: calc(var(--n) - 2);
    }
    .hero__member {
      width: calc(100% / var(--n-mobile) * 1.32);
      margin-inline: calc(100% / var(--n-mobile) * -0.16);
    }
    .hero__member:first-child,
    .hero__member:last-child {
      display: none;
    }
    .hero__stage :global(.hero__note--3) {
      display: none;
    }
    :global(.hero__note--1) {
      top: 0;
    }
    .hero__scene {
      margin-inline: 0;
    }
  }
  @media (max-width: 420px) {
    .hero__ctas {
      flex-direction: column;
      width: 100%;
    }
    /* Téléphone : étincelles plus petites, au-dessus des coins du titre */
    :global(.hero__spark--l) {
      left: -0.35em;
      top: -0.85em;
      scale: 0.7;
    }
    :global(.hero__spark--r) {
      right: -0.35em;
      top: -0.9em;
      scale: 0.7;
    }
  }
</style>
