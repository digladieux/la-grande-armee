---
import type { Product } from '@/data/products';
import CTA from '@/components/ui/CTA.astro';
import ProductGrid from '@/components/shop/ProductGrid.astro';

interface Props {
  products: Product[];
}
const { products } = Astro.props;
---

<section class="section shop">
  <div class="container">
    <div class="shop__head">
      <div>
        <span class="eyebrow">Ouverture prochaine</span>
        <h2 class="title-lg">La boutique</h2>
      </div>
      <CTA href="/boutique" variant="secondary">Voir la boutique</CTA>
    </div>

    <ProductGrid products={products} fallbackHref="/boutique" />
  </div>
</section>

<style>
  .shop {
    background: var(--paper-2);
    border-top: var(--border);
  }
  .shop__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(24px, 4vw, 40px);
  }
  .shop__head .eyebrow {
    margin-bottom: 10px;
  }
</style>
