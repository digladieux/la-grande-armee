---
import type { Character } from '@/data/characters';
import CharacterFigure from '@/components/characters/CharacterFigure.astro';
import CTA from '@/components/ui/CTA.astro';
import Annotation from '@/components/ui/Annotation.astro';

interface Props {
  character: Character;
}
const { character } = Astro.props;
---

<section class="section quiz">
  <div class="container">
    <div class="quiz__panel">
      <div class="quiz__text">
        <span class="eyebrow">Le quiz</span>
        <h2 class="title-lg">À quel copain ressembles-tu&nbsp;?</h2>
        <p class="lead">Fais le test et découvre quel personnage de La Grande Armée te ressemble le plus.</p>
        <CTA href="/quiz">Faire le quiz</CTA>
      </div>

      <div class="quiz__visual" aria-hidden="true">
        <div class="quiz__disc stripes"></div>
        <div class="quiz__figure">
          <CharacterFigure character={character} full />
        </div>
        <Annotation class="quiz__note quiz__note--1" arrow="down-right" rotate={-8}>Team canapé ?</Annotation>
        <Annotation class="quiz__note quiz__note--2" arrow="down-left" rotate={6}>Plutôt apéro ?</Annotation>
        <Annotation class="quiz__note quiz__note--3" arrow="left" rotate={-4}>ou aventure ?</Annotation>
      </div>
    </div>
  </div>
</section>

<style>
  .quiz__panel {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 32px;
    padding: clamp(32px, 5vw, 64px);
    padding-bottom: 0;
    border: var(--border);
    border-radius: calc(var(--radius) * 2);
    background: color-mix(in srgb, var(--purple) 38%, var(--paper));
    box-shadow: 6px 6px 0 var(--ink);
    overflow: hidden;
  }
  .quiz__text {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding-bottom: clamp(32px, 5vw, 64px);
  }
  .quiz__text .lead {
    color: var(--ink);
    margin-bottom: 8px;
  }
  .quiz__visual {
    position: relative;
    align-self: end;
    height: 100%;
    min-height: 320px;
  }
  .quiz__disc {
    position: absolute;
    left: 50%;
    bottom: -30%;
    width: 88%;
    aspect-ratio: 1;
    border: var(--border);
    border-radius: 50%;
    transform: translateX(-50%) rotate(12deg);
    background-size: 140% 140%;
  }
  .quiz__figure {
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: min(62%, 260px);
    aspect-ratio: 200 / 280;
    transform: translateX(-50%);
  }
  :global(.quiz__note) {
    position: absolute;
  }
  :global(.quiz__note--1) {
    left: 0;
    top: 6%;
  }
  :global(.quiz__note--2) {
    right: 0;
    top: 0;
  }
  :global(.quiz__note--3) {
    right: -2%;
    top: 46%;
  }
  /* Téléphone : bloc compact, texte à gauche et copain à droite */
  @media (max-width: 800px) {
    .quiz__panel {
      grid-template-columns: 1fr 34%;
      gap: 8px;
      padding: 20px 0 0 18px;
      box-shadow: 4px 4px 0 var(--ink);
    }
    .quiz__text {
      gap: 10px;
      padding-bottom: 20px;
    }
    .quiz__text .title-lg {
      font-size: clamp(1.6rem, 7vw, 2.2rem);
    }
    .quiz__text .lead {
      margin-bottom: 2px;
      font-size: 0.9rem;
      line-height: 1.4;
    }
    .quiz__text :global(.cta) {
      min-height: 42px;
      padding: 0.6em 1.1em;
      font-size: 0.78rem;
    }
    .quiz__visual {
      min-height: 0;
    }
    .quiz__figure {
      width: 100%;
    }
    .quiz__disc {
      width: 150%;
      bottom: -40%;
    }
    .quiz__visual :global(.quiz__note) {
      display: none;
    }
  }
</style>
