---
import Logo from './Logo.astro';
import { mainNav, legalNav } from '@/data/navigation';
import { url } from '@/lib/url';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__stripes stripes" aria-hidden="true"></div>
  <div class="footer__inner container">
    <div class="footer__brand">
      <Logo size="lg" inverted />
      <p class="footer__baseline hand">La bande de copains qu'on n'a jamais choisie.</p>
    </div>

    <nav class="footer__col" aria-label="Plan du site">
      <h2 class="footer__heading">Explorer</h2>
      <ul>
        {mainNav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>

  </div>

  <div class="footer__bottom container">
    <p>© {year} La Grande Armée</p>
    <ul>
      {legalNav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--paper);
  }
  .footer__stripes {
    height: 14px;
    background-size: 280px 280px;
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
    padding-block: 64px 48px;
  }
  .footer__baseline {
    margin-top: 20px;
    font-size: 1.5rem;
    color: var(--yellow);
    max-width: 18ch;
  }
  .footer__heading {
    margin-bottom: 16px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgb(255 252 244 / 0.55);
  }
  .footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__col li + li {
    margin-top: 8px;
  }
  .footer a {
    text-decoration: none;
  }
  .footer__col a:hover,
  .footer__bottom a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 20px 28px;
    border-top: 1px solid rgb(255 252 244 / 0.15);
    font-size: 0.85rem;
    color: rgb(255 252 244 / 0.6);
  }
  .footer__bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  @media (max-width: 800px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
