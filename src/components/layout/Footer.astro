---
import Logo from './Logo.astro';
import { mainNav, legalNav, socialLinks } from '@/data/navigation';
import { url } from '@/lib/url';

const year = new Date().getFullYear();
const icons: Record<string, string> = {
  instagram: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm5.5-1.5h.01',
  tiktok: 'M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.6 2.4 4.4 5 4.6',
  facebook: 'M14 21v-8h3l.5-3.5H14V7.7c0-1 .3-1.7 1.8-1.7H18V3.2A24 24 0 0 0 15.3 3C12.8 3 11 4.5 11 7.3v2.2H8V13h3v8',
};
---

<footer class="footer">
  <div class="footer__stripes stripes" aria-hidden="true"></div>
  <div class="footer__inner container">
    <div class="footer__brand">
      <Logo size="lg" inverted />
      <p class="footer__baseline hand">La bande de copains qu'on n'a jamais choisie.</p>
    </div>

    <nav class="footer__col" aria-label="Plan du site">
      <h2 class="footer__heading">Explorer</h2>
      <ul>
        {mainNav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__heading">Suivre la bande</h2>
      <ul class="footer__socials">
        {socialLinks.map((s) => (
          <li>
            <a href={s.href || '#'} aria-label={s.label} aria-disabled={s.href ? undefined : 'true'} target={s.href ? '_blank' : undefined} rel={s.href ? 'noopener' : undefined}>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path d={icons[s.icon]} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer__bottom container">
    <p>© {year} La Grande Armée</p>
    <ul>
      {legalNav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--paper);
  }
  .footer__stripes {
    height: 14px;
    background-size: 280px 280px;
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 48px;
    padding-block: 64px 48px;
  }
  .footer__baseline {
    margin-top: 20px;
    font-size: 1.5rem;
    color: var(--yellow);
    max-width: 18ch;
  }
  .footer__heading {
    margin-bottom: 16px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgb(255 252 244 / 0.55);
  }
  .footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__col li + li {
    margin-top: 8px;
  }
  .footer a {
    text-decoration: none;
  }
  .footer__col a:hover,
  .footer__bottom a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer__socials {
    display: flex;
    gap: 10px;
  }
  .footer__col .footer__socials li + li {
    margin-top: 0;
  }
  .footer__socials a {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 2px solid rgb(255 252 244 / 0.35);
    border-radius: 50%;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .footer__socials a:hover {
    background: var(--yellow);
    border-color: var(--yellow);
    color: var(--ink);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 20px 28px;
    border-top: 1px solid rgb(255 252 244 / 0.15);
    font-size: 0.85rem;
    color: rgb(255 252 244 / 0.6);
  }
  .footer__bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  @media (max-width: 800px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
