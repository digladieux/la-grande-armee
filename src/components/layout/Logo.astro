---
import { url } from '@/lib/url';

interface Props {
  size?: 'sm' | 'lg';
  inverted?: boolean;
}
const { size = 'sm', inverted = false } = Astro.props;
---

<a href={url('/')} class:list={['logo', `logo--${size}`, { 'logo--inverted': inverted }]} aria-label="La Grande Armée — accueil">
  <img class="logo__line" src={url('/images/titre-la-grande.svg')} alt="" />
  <img class="logo__line logo__line--big" src={url('/images/titre-armee.svg')} alt="" />
  <span class="logo__stripe stripes" aria-hidden="true"></span>
</a>

<style>
  .logo {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    font-family: var(--font-display);
    line-height: 0.86;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    transform: rotate(-3deg);
  }
  .logo--inverted {
    color: var(--paper);
  }
  /* Titre dessiné (scripts/titre-svg.py) : « LA GRANDE » petit, « ARMÉE » grand */
  .logo__line {
    display: block;
    height: 15px;
    width: auto;
    max-width: none; /* sinon largeur nulle dans le conteneur inline-flex (max-width: 100% global) */
  }
  .logo__line--big {
    height: 26px;
    margin-top: 2px;
  }
  .logo--inverted .logo__line {
    filter: invert(1);
  }
  .logo__stripe {
    width: 100%;
    height: 5px;
    margin-top: 3px;
    border-radius: 3px;
    background-size: 60px 60px;
  }
  .logo--lg .logo__line {
    height: 26px;
  }
  .logo--lg .logo__line--big {
    height: 46px;
  }
  .logo--lg .logo__stripe {
    height: 8px;
  }
</style>
